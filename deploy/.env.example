# MMBOT 企业私有化部署配置（deploy/compose.offline.yml 与 deploy/install.sh 共用）
#
# 复制为 deploy/.env 后逐项填写：
#   cp deploy/.env.example deploy/.env
# 值中不要包含空格；必须含空格或特殊字符时用单引号包裹，例如 MMBOT_MODEL_NAME='DeepSeek 企业版'。
# 本文件会提交到仓库，真实密钥不要写在这里；deploy/.env 已被 deploy/.gitignore 忽略。

# ---------- 镜像 ----------
# 离线主机执行 `deploy/install.sh load` 之后的镜像名。
# 生产环境建议固定版本号（如 ds-bot:0.1.3），回滚时把这里改回旧 tag 即可。
MMBOT_IMAGE=ds-bot:local
# 反向代理镜像，仅在 --profile proxy 时使用；离线主机需要预加载同一个镜像。
MMBOT_PROXY_IMAGE=nginx:1.27-alpine

# ---------- 端口与监听 ----------
# 宿主机发布端口；容器内的 dsh web 始终监听 3080。
MMBOT_PORT=3080
# 宿主机发布地址：
#   127.0.0.1 —— 只允许本机访问，对外一律走反向代理（推荐，默认）；
#   0.0.0.0   —— 直接暴露给内网（此时必须把访问用的 IP/域名写进 DSH_TRUSTED_HOST）。
MMBOT_BIND_ADDRESS=127.0.0.1
# 反向代理对外端口（--profile proxy 生效时使用）。443 需要 root 或 CAP_NET_BIND_SERVICE。
MMBOT_TLS_PORT=443

# ---------- 数据目录 ----------
# 相对路径以 deploy/ 为基准，也可以写绝对路径（例如 /srv/mmbot/data）。
# DATA_DIR 是 DSH_HOME：Bot 团队、会话、登录态、模型配置都在这里，备份优先保住它。
DATA_DIR=./data
# Bot 的工作目录，Bot 能读写的文件都在这里。
WORKSPACE_DIR=./workspace
# 容器内进程与新文件的属主，填 `id -u` / `id -g` 的结果（Linux 上通常是 1000）。
PUID=1000
PGID=1000

# ---------- 访问入口与信任域 ----------
# 浏览器实际打开的域名或 IP，逗号分隔，不带端口。
# dsh web 对不在名单里的 Host 的 API 请求一律返回 403；用反向代理时写对外域名。
# 例：DSH_TRUSTED_HOST=mmbot.corp.example,192.168.10.20
DSH_TRUSTED_HOST=localhost,127.0.0.1
# 反向代理证书目录，需包含 fullchain.pem 与 privkey.pem；相对路径以 deploy/ 为基准。
MMBOT_TLS_DIR=./proxy/tls

# ---------- 模型网关（OpenAI 兼容）----------
# 网关地址必须以 /v1 结尾；自检会请求 ${MMBOT_GATEWAY_BASE_URL}/models 验证连通性。
# 网关跑在宿主机上时，容器内用 host.docker.internal 访问（compose 已加 host-gateway）。
MMBOT_GATEWAY_BASE_URL=http://host.docker.internal:4000/v1
# 网关访问令牌（Bearer）。install.sh 会把它写进 DATA_DIR/cordis.patch.yml 的 apiKeyEnv。
MMBOT_GATEWAY_API_KEY=
# 团队默认模型 id，必须与网关上 /models 返回的某个 id 完全一致，区分大小写。
MMBOT_MODEL_ID=deepseek-chat
# 可选：模型显示名。
MMBOT_MODEL_NAME=DeepSeek Chat
# 模型的上下文窗口（token）。缺失会让 MMBOT 的长度线算错，务必按网关实际值填写。
MMBOT_MODEL_CONTEXT_WINDOW=131072
# 单次回复上限（token）。
MMBOT_MODEL_MAX_TOKENS=8192

# ---------- 遥测 ----------
# 1 = 关闭 dsh 的匿名遥测（内网环境建议保持 1）。
DSH_TELEMETRY_DISABLED=1

# ---------- 构建参数（只在 prepare 构建镜像时使用）----------
# npm 镜像源：内网用企业私有源，中国内地可用 https://registry.npmmirror.com/。
NPM_REGISTRY=https://registry.npmjs.org/
# 镜像内置的 DSH 版本；与 docker/Dockerfile 的默认值保持一致，改动前先确认兼容性。
DSH_VERSION=0.2.0-rc.2
